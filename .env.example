# LLM Provider Configuration (one or both)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Choose default LLM provider: "openai" or "groq"
# If not specified, it will fallback automatically to the provider with key set,
# or mock responses if neither is set.
DEFAULT_LLM_PROVIDER=openai

# Web Search Configuration (choose one or more)
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here
EXA_API_KEY=your_exa_api_key_here

# FastAPI Configuration
HOST=127.0.0.1
PORT=8000
